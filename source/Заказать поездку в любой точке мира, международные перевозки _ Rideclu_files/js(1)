// uv — WebGL-конвенция, экранный edge-таргет сэмплится через flip (sampleEdges),
// LUT — напрямую (ориентация выровнена при загрузке, см. postEffectsPass).

struct PostUniforms {
    // xy = размер канваса в пикселях, zw = 1/размер
    size: vec4f,
};

@group(0) @binding(0) var<uniform> post: PostUniforms;
@group(0) @binding(1) var edgesTexture: texture_2d<f32>;
@group(0) @binding(2) var linearSampler: sampler;
@group(0) @binding(3) var areaTexture: texture_2d<f32>;
@group(0) @binding(4) var searchTexture: texture_2d<f32>;
@group(0) @binding(5) var nearestSampler: sampler;

// SMAA_PRESET_ULTRA (как в smaa_edge.fsh legacy: единый пресет обоих пассов)
const SMAA_MAX_SEARCH_STEPS: i32 = 32;
const SMAA_MAX_SEARCH_STEPS_DIAG: i32 = 16;
const SMAA_CORNER_ROUNDING: f32 = 25.0;

const SMAA_AREATEX_MAX_DISTANCE: f32 = 16.0;
const SMAA_AREATEX_MAX_DISTANCE_DIAG: f32 = 20.0;
const SMAA_AREATEX_PIXEL_SIZE: vec2f = vec2f(1.0 / 160.0, 1.0 / 560.0);
const SMAA_AREATEX_SUBTEX_SIZE: f32 = 1.0 / 7.0;
const SMAA_SEARCHTEX_SIZE: vec2f = vec2f(66.0, 33.0);
const SMAA_SEARCHTEX_PACKED_SIZE: vec2f = vec2f(64.0, 16.0);
const SMAA_CORNER_ROUNDING_NORM: f32 = SMAA_CORNER_ROUNDING / 100.0;

fn texelSize() -> vec2f {
    return post.size.zw;
}

fn sampleEdges(uv: vec2f) -> vec4f {
    return textureSampleLevel(edgesTexture, linearSampler, vec2f(uv.x, 1.0 - uv.y), 0.0);
}

// SMAASampleLevelZeroOffset
fn sampleEdgesOffset(uv: vec2f, offset: vec2f) -> vec4f {
    return sampleEdges(uv + offset * texelSize());
}

fn sampleArea(uv: vec2f) -> vec4f {
    return textureSampleLevel(areaTexture, nearestSampler, uv, 0.0);
}

fn sampleSearch(uv: vec2f) -> vec4f {
    return textureSampleLevel(searchTexture, nearestSampler, uv, 0.0);
}

fn roundv2(v: vec2f) -> vec2f {
    return floor(v + vec2f(0.5));
}

// Распаковка двух бинарных значений из билинейной выборки (см. GLSL-комментарий)
fn SMAADecodeDiagBilinearAccess2(eIn: vec2f) -> vec2f {
    var e = eIn;
    e.r = e.r * abs(5.0 * e.r - 5.0 * 0.75);
    return roundv2(e);
}

fn SMAADecodeDiagBilinearAccess4(eIn: vec4f) -> vec4f {
    var e = eIn;
    let rb = e.rb * abs(5.0 * e.rb - 5.0 * 0.75);
    e.r = rb.x;
    e.b = rb.y;
    return floor(e + vec4f(0.5));
}

struct DiagSearchResult {
    zw: vec2f,
    e: vec2f,
};

fn SMAASearchDiag1(texcoord: vec2f, dir: vec2f) -> DiagSearchResult {
    var coord = vec4f(texcoord, -1.0, 1.0);
    let t = vec3f(texelSize(), 1.0);
    var e = vec2f(0.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(coord.z < f32(SMAA_MAX_SEARCH_STEPS_DIAG - 1) && coord.w > 0.9)) {
            break;
        }
        let xyz = t * vec3f(dir, 1.0) + coord.xyz;
        coord = vec4f(xyz, coord.w);
        e = sampleEdges(coord.xy).rg;
        coord.w = dot(e, vec2f(0.5, 0.5));
    }
    return DiagSearchResult(coord.zw, e);
}

fn SMAASearchDiag2(texcoord: vec2f, dir: vec2f) -> DiagSearchResult {
    var coord = vec4f(texcoord, -1.0, 1.0);
    coord.x += 0.25 * texelSize().x; // @SearchDiag2Optimization
    let t = vec3f(texelSize(), 1.0);
    var e = vec2f(0.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(coord.z < f32(SMAA_MAX_SEARCH_STEPS_DIAG - 1) && coord.w > 0.9)) {
            break;
        }
        let xyz = t * vec3f(dir, 1.0) + coord.xyz;
        coord = vec4f(xyz, coord.w);
        // Обе кромки одной билинейной выборкой
        e = SMAADecodeDiagBilinearAccess2(sampleEdges(coord.xy).rg);
        coord.w = dot(e, vec2f(0.5, 0.5));
    }
    return DiagSearchResult(coord.zw, e);
}

fn SMAAAreaDiag(dist: vec2f, e: vec2f, offset: f32) -> vec2f {
    var texcoord = vec2f(SMAA_AREATEX_MAX_DISTANCE_DIAG) * e + dist;
    texcoord = SMAA_AREATEX_PIXEL_SIZE * texcoord + 0.5 * SMAA_AREATEX_PIXEL_SIZE;
    // Диагональные area — во второй половине текстуры
    texcoord.x += 0.5;
    texcoord.y += SMAA_AREATEX_SUBTEX_SIZE * offset;
    return sampleArea(texcoord).rg;
}

fn SMAACalculateDiagWeights(texcoord: vec2f, e: vec2f, subsampleIndices: vec4f) -> vec2f {
