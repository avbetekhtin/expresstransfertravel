    let ts = texelSize();

    var d: vec4f;
    if (e.r > 0.0) {
        let r1 = SMAASearchDiag1(texcoord, vec2f(-1.0, 1.0));
        d.x = r1.zw.x + f32(r1.e.y > 0.9);
        d.z = r1.zw.y;
    } else {
        d.x = 0.0;
        d.z = 0.0;
    }
    let r2 = SMAASearchDiag1(texcoord, vec2f(1.0, -1.0));
    d.y = r2.zw.x;
    d.w = r2.zw.y;

    if (d.x + d.y > 2.0) { // d.x + d.y + 1 > 3
        let coords = vec4f(-d.x + 0.25, d.x, d.y, -d.y - 0.25) * vec4f(ts, ts) + texcoord.xyxy;
        var c: vec4f;
        let cxy = sampleEdgesOffset(coords.xy, vec2f(-1.0, 0.0)).rg;
        let czw = sampleEdgesOffset(coords.zw, vec2f(1.0, 0.0)).rg;
        c = vec4f(cxy, czw);
        let dec = SMAADecodeDiagBilinearAccess4(c);
        // GLSL: c.yxwz = dec.xyzw
        c = vec4f(dec.y, dec.x, dec.w, dec.z);

        var cc = vec2f(2.0) * c.xz + c.yw;
        // Убираем crossing edge, если конец линии не найден
        cc = select(cc, vec2f(0.0), vec2<bool>(step(vec2f(0.9), d.zw)));

        weights += SMAAAreaDiag(d.xy, cc, subsampleIndices.z);
    }

    let r3 = SMAASearchDiag2(texcoord, vec2f(-1.0, -1.0));
    d.x = r3.zw.x;
    d.z = r3.zw.y;
    if (sampleEdgesOffset(texcoord, vec2f(1.0, 0.0)).r > 0.0) {
        let r4 = SMAASearchDiag2(texcoord, vec2f(1.0, 1.0));
        d.y = r4.zw.x + f32(r4.e.y > 0.9);
        d.w = r4.zw.y;
    } else {
        d.y = 0.0;
        d.w = 0.0;
    }

    if (d.x + d.y > 2.0) { // d.x + d.y + 1 > 3
        let coords = vec4f(-d.x, -d.x, d.y, d.y) * vec4f(ts, ts) + texcoord.xyxy;
        var c: vec4f;
        c.x = sampleEdgesOffset(coords.xy, vec2f(-1.0, 0.0)).g;
        c.y = sampleEdgesOffset(coords.xy, vec2f(0.0, -1.0)).r;
        let zw = sampleEdgesOffset(coords.zw, vec2f(1.0, 0.0)).gr;
        c.z = zw.x;
        c.w = zw.y;
        var cc = vec2f(2.0) * c.xz + c.yw;
        cc = select(cc, vec2f(0.0), vec2<bool>(step(vec2f(0.9), d.zw)));

        weights += SMAAAreaDiag(d.xy, cc, subsampleIndices.w).gr;
    }

    return weights;
}

fn SMAASearchLength(e: vec2f, offset: f32) -> f32 {
    // Текстура флипнута вертикально, left/right делят её пополам по горизонтали
    var scale = SMAA_SEARCHTEX_SIZE * vec2f(0.5, -1.0);
    var bias = SMAA_SEARCHTEX_SIZE * vec2f(offset, 1.0);

    scale += vec2f(-1.0, 1.0);
    bias += vec2f(0.5, -0.5);

    scale *= 1.0 / SMAA_SEARCHTEX_PACKED_SIZE;
    bias *= 1.0 / SMAA_SEARCHTEX_PACKED_SIZE;

    return sampleSearch(scale * e + bias).r;
}

fn SMAASearchXLeft(texcoordIn: vec2f, end: f32) -> f32 {
    // @PSEUDO_GATHER4: texcoord смещён на (-0.25, -0.125), билинейная выборка
    // берёт 4 кромки за раз
    var texcoord = texcoordIn;
    var e = vec2f(0.0, 1.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(texcoord.x > end && e.g > 0.8281 && e.r == 0.0)) {
            break;
        }
        e = sampleEdges(texcoord).rg;
        texcoord = -vec2f(2.0, 0.0) * texelSize() + texcoord;
    }
    let offset = -(255.0 / 127.0) * SMAASearchLength(e, 0.0) + 3.25;
    return texelSize().x * offset + texcoord.x;
}

fn SMAASearchXRight(texcoordIn: vec2f, end: f32) -> f32 {
    var texcoord = texcoordIn;
    var e = vec2f(0.0, 1.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(texcoord.x < end && e.g > 0.8281 && e.r == 0.0)) {
            break;
        }
        e = sampleEdges(texcoord).rg;
        texcoord = vec2f(2.0, 0.0) * texelSize() + texcoord;
    }
    let offset = -(255.0 / 127.0) * SMAASearchLength(e, 0.5) + 3.25;
    return -texelSize().x * offset + texcoord.x;
}

fn SMAASearchYUp(texcoordIn: vec2f, end: f32) -> f32 {
    var texcoord = texcoordIn;
    var e = vec2f(1.0, 0.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(texcoord.y > end && e.r > 0.8281 && e.g == 0.0)) {
            break;
        }
        e = sampleEdges(texcoord).rg;
        texcoord = -vec2f(0.0, 2.0) * texelSize() + texcoord;
    }
    let offset = -(255.0 / 127.0) * SMAASearchLength(e.gr, 0.0) + 3.25;
    return texelSize().y * offset + texcoord.y;
}

fn SMAASearchYDown(texcoordIn: vec2f, end: f32) -> f32 {
    var texcoord = texcoordIn;
    var e = vec2f(1.0, 0.0);
    for (var i = 0; i < SMAA_MAX_SEARCH_STEPS; i++) {
        if (!(texcoord.y < end && e.r > 0.8281 && e.g == 0.0)) {
            break;
        }
        e = sampleEdges(texcoord).rg;
        texcoord = vec2f(0.0, 2.0) * texelSize() + texcoord;
    }
    let offset = -(255.0 / 127.0) * SMAASearchLength(e.gr, 0.5) + 3.25;
    return -texelSize().y * offset + texcoord.y;
}

fn SMAAArea(dist: vec2f, e1: f32, e2: f32, offset: f32) -> vec2f {
    // Округление против ошибок точности билинейной фильтрации
    var texcoord = vec2f(SMAA_AREATEX_MAX_DISTANCE) * roundv2(4.0 * vec2f(e1, e2)) + dist;
    texcoord = SMAA_AREATEX_PIXEL_SIZE * texcoord + 0.5 * SMAA_AREATEX_PIXEL_SIZE;
    texcoord.y = SMAA_AREATEX_SUBTEX_SIZE * offset + texcoord.y;
    return sampleArea(texcoord).rg;
}

fn SMAADetectHorizontalCornerPattern(weightsIn: vec2f, texcoord: vec4f, d: vec2f) -> vec2f {
    let leftRight = step(d.xy, d.yx);
    var rounding = (1.0 - SMAA_CORNER_ROUNDING_NORM) * leftRight;
    rounding /= leftRight.x + leftRight.y; // меньше блендинга в центре линии

    var factor = vec2f(1.0, 1.0);
    factor.x -= rounding.x * sampleEdgesOffset(texcoord.xy, vec2f(0.0, 1.0)).r;
    factor.x -= rounding.y * sampleEdgesOffset(texcoord.zw, vec2f(1.0, 1.0)).r;
    factor.y -= rounding.x * sampleEdgesOffset(texcoord.xy, vec2f(0.0, -2.0)).r;
    factor.y -= rounding.y * sampleEdgesOffset(texcoord.zw, vec2f(1.0, -2.0)).r;

    return weightsIn * saturate(factor);
}

fn SMAADetectVerticalCornerPattern(weightsIn: vec2f, texcoord: vec4f, d: vec2f) -> vec2f {
    let leftRight = step(d.xy, d.yx);
    var rounding = (1.0 - SMAA_CORNER_ROUNDING_NORM) * leftRight;
    rounding /= leftRight.x + leftRight.y;

    var factor = vec2f(1.0, 1.0);
    factor.x -= rounding.x * sampleEdgesOffset(texcoord.xy, vec2f(1.0, 0.0)).g;
    factor.x -= rounding.y * sampleEdgesOffset(texcoord.zw, vec2f(1.0, 1.0)).g;
    factor.y -= rounding.x * sampleEdgesOffset(texcoord.xy, vec2f(-2.0, 0.0)).g;
    factor.y -= rounding.y * sampleEdgesOffset(texcoord.zw, vec2f(-2.0, 1.0)).g;

    return weightsIn * saturate(factor);
}

